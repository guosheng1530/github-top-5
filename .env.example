# 复制本文件为 .env 后填入真实值；.env 不会被提交
# 火山方舟文本模型（OpenAI 兼容接口）
LLM_API_KEY=ark-xxxxxxxxxxxxxxxx
LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
LLM_MODEL=你的模型或推理接入点ID

# GitHub Token（只读公开元数据；不配置也能跑，只是额度较低）
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxx

# 以下能力仅在火山方舟控制台确认开通后填写，留空 = not_configured（自动回退模板素材）
ARK_IMAGE_MODEL=
ARK_VIDEO_MODEL=
ARK_TTS_MODEL=
ARK_TTS_VOICE=

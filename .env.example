# 复制本文件为 .env 后填入真实值；.env 不会被提交
# 火山方舟文本模型（OpenAI 兼容接口）
LLM_API_KEY=ark-xxxxxxxxxxxxxxxx
LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
LLM_MODEL=你的模型或推理接入点ID

# GitHub Token（只读公开元数据；不配置也能跑，只是额度较低）
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxx

# ========================= 图片生成（Seedream / 火山方舟 Agent Plan，v1.2.0） =========================
# 重要：Agent Plan 使用【专属 API Key】+【专属 Base URL（路径含 /plan）】。
#   * Coding Plan 的 Key 无法在 Agent Plan 调用（会 401）；
#   * 留空 ARK_IMAGE_MODEL = not_configured，VisualAgent 自动回退 Pillow 程序化信息卡。
# 开通 Agent Plan 生图后填写：
ARK_IMAGE_MODEL=                 # 例：doubao-seedream-5-0-pro（留空=回退 Pillow）
ARK_IMAGE_API_KEY=               # Agent Plan 专属 Key；留空则回退到 LLM_API_KEY（仅当它也属 Agent Plan 才对）
ARK_IMAGE_BASE_URL=https://ark.cn-beijing.volces.com/api/plan/v3
ARK_IMAGE_SIZE=2K                # 1K / 1.5K / 2K 预设，或精确像素如 2048x1152（seedream-5-0-pro 仅 1K/2K）
ARK_IMAGE_OUTPUT_FORMAT=png      # png / jpeg
ARK_IMAGE_WATERMARK=0            # 1=开启水印；商用成片建议 0
ARK_IMAGE_TIMEOUT=300            # seedream-5-0-pro 约 2 分钟/张，超时需 ≥240s
IMAGE_PROVIDER=auto              # auto=有配置就用 Seedream 失败回退 Pillow；pillow=强制模板；seedream=强制生图(不回退)
IMAGE_FALLBACK_TO_TEMPLATE=1     # auto 模式下 Seedream 失败是否回退 Pillow

# 以下能力仅在火山方舟控制台确认开通后填写，留空 = not_configured（自动回退模板素材）
ARK_VIDEO_MODEL=
ARK_TTS_MODEL=
ARK_TTS_VOICE=

# ========================= 企业微信群机器人通知（可选，默认关闭） =========================
# 获取方式：企业微信群 → 右上角 → 添加群机器人 → 复制 Webhook 地址
#   形如 https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxxxxxxx
# 两项都配置后，任务完成会向该群推送一条文本通知（成片路径 + 质检结论）。
WECHAT_NOTIFY=0                  # 1=开启；0/留空=不发送
WECHAT_WEBHOOK_URL=             # 企业微信群机器人 Webhook 完整地址（含 ?key=...）


#开启openclaw
#OPENCLAW_NOTIFY=1
